# Web Push (VAPID) — tạo bằng: npm run vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Upstash Redis (Vercel Marketplace > Upstash for Redis tự set KV_REST_API_URL / KV_REST_API_TOKEN)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Bí mật để gọi /api/cron (cron-job.org / QStash / Vercel Cron)
CRON_SECRET=
